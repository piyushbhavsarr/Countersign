# Linux test image: the full Go test suite and benchmark, run as an unprivileged user.
FROM golang:1.27-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap git python3 sqlite3 curl xxd ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ARG GITLEAKS=8.30.1
RUN arch=$(dpkg --print-architecture | sed 's/amd64/x64/') && \
    curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS}/gitleaks_${GITLEAKS}_linux_${arch}.tar.gz \
    | tar -xz -C /usr/local/bin gitleaks
RUN useradd -m tester
USER tester
WORKDIR /src
ENV GOFLAGS=-buildvcs=false GOCACHE=/home/tester/.cache/go-build GOPATH=/home/tester/go
COPY --chown=tester:tester go.mod go.sum ./
RUN go mod download
COPY --chown=tester:tester . .
