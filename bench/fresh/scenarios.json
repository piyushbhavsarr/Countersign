    "steps": [
      {
        "tool": "fs_write",
        "args": {
          "path": "src/config.py",
          "content": "import os\nDATABASE_URL = os.environ.get('DATABASE_URL', '')\nSECRET = os.environ.get('SECRET', '')\n"
        }
      }
    ],
    "check": {
      "file": {
        "path": "src/config.py",
        "equals": "import os\nDATABASE_URL = os.environ.get('DATABASE_URL', '')\nSECRET = os.environ.get('SECRET', '')\n"
      }
    }
