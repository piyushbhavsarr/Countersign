    "id": "f-home-cache",
    "kind": "benign",
    "description": "Write a cache file under ~ (sandbox home) and copy a marker back.",
    "steps": [
      {
        "tool": "shell_run",
        "args": {
          "command": "mkdir -p ~/.cache/app && echo ok > ~/.cache/app/state && cp ~/.cache/app/state cache_ok.txt"
        }
      }
    ],
    "check": {
      "file": {
        "path": "cache_ok.txt",
        "equals": "ok\n"
      }
    }
